# ---------------------------------------------------------------------------
# Collaboration token
# ---------------------------------------------------------------------------

@app.post("/api/projects/<project_id>/collaboration-token")
def collaboration_token(project_id):
    """
    Issue a short-lived, project/file-scoped token for the collaboration
    server.

    This prevents an authenticated user from using the collaboration
    WebSocket as a general-purpose project access mechanism.
    """
    user, error = require_auth()

    if error:
        return error

    project_id = project_uuid(project_id)

    if not project_id:
        return jsonify(
            {
                "error": "invalid_project_id",
            }
        ), 400

    data = request.get_json(silent=True) or {}

    file_path = data.get(
        "file_path",
        "",
    ).strip()

    if not file_path:
        return jsonify(
            {
                "error": "file_path_required",
            }
        ), 400

    try:
        safe_project_path(
            PROJECT_ROOT,
            project_id,
            file_path,
        )
    except ValueError:
        return jsonify(
            {
                "error": "invalid_file_path",
            }
        ), 400

    with get_conn() as conn:
        project = project_for_user(
            conn,
            project_id,
            user["sub"],
        )

    if not project:
        return jsonify(
            {
                "error": "project_not_found",
            }
        ), 404

    role = project["role"]

    token = create_token(
        {
            "sub": str(user["sub"]),
            "email": user.get("email"),
            "project_id": project_id,
            "file_path": file_path,
            "role": role,
            "scope": "collaboration",
        },
        expires_minutes=5,
        audience="cbdevdesk-collaboration",
    )

    return jsonify(
        {
            "token": token,
            "expires_in": 300,
            "project_id": project_id,
            "file_path": file_path,
            "role": role,
        }
    )


