# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def current_user():
    """Return the authenticated user from the Bearer token."""
    header = request.headers.get("Authorization", "")

    if not header.startswith("Bearer "):
        return None

    token = header.removeprefix("Bearer ").strip()

    if not token:
        return None

    try:
        return decode_token(token)
    except Exception:
        return None


def require_auth():
    user = current_user()

    if not user:
        return None, (
            jsonify({"error": "authentication_required"}),
            401,
        )

    return user, None


def project_uuid(value):
    """Validate a project UUID."""
    try:
        return str(uuid.UUID(value))
    except (ValueError, AttributeError, TypeError):
        return None


def project_for_user(conn, project_id, user_id):
    """
    Return the project and membership role for a user.

    Membership is authoritative; JWT role claims are not trusted for
    project authorization.
    """
    with conn.cursor() as cur:
        cur.execute(
            """
            SELECT
                p.id,
                p.name,
                p.owner_id,
                pm.role
            FROM projects p
            JOIN project_members pm
              ON pm.project_id = p.id
            WHERE p.id = %s
              AND pm.user_id = %s
            """,
            (project_id, user_id),
        )

        return cur.fetchone()


