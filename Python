@app.get("/api/projects/<project_id>/tree")
def project_tree(project_id):
    user, error = require_auth()

    if error:
        return error

    project_id = project_uuid(project_id)

    if not project_id:
        return jsonify(
            {
                "error": "invalid_project_id",
            }
        ), 400

    with get_conn() as conn:
        project = project_for_user(
            conn,
            project_id,
            user["sub"],
        )

    if not project:
        return jsonify(
            {
                "error": "project_not_found",
            }
        ), 404

    root = os.path.join(
        PROJECT_ROOT,
        project_id,
    )

    return jsonify(
        {
            "project_id": project_id,
            "tree": list_tree(root),
        }
    )


