@app.get("/api/projects/<project_id>/files/<path:file_path>")
def read_file(project_id, file_path):
    user, error = require_auth()

    if error:
        return error

    project_id = project_uuid(project_id)

    if not project_id:
        return jsonify(
            {
                "error": "invalid_project_id",
            }
        ), 400

    with get_conn() as conn:
        project = project_for_user(
            conn,
            project_id,
            user["sub"],
        )

    if not project:
        return jsonify(
            {
                "error": "project_not_found",
            }
        ), 404

    try:
        path = safe_project_path(
            PROJECT_ROOT,
            project_id,
            file_path,
        )
    except ValueError:
        return jsonify(
            {
                "error": "invalid_file_path",
            }
        ), 400

    if not os.path.isfile(path):
        return jsonify(
            {
                "error": "file_not_found",
            }
        ), 404

    try:
        with open(
            path,
            "r",
            encoding="utf-8",
        ) as handle:
            content = handle.read()

    except UnicodeDecodeError:
        return jsonify(
            {
                "error": "binary_file_not_supported",
            }
        ), 415

    return jsonify(
        {
            "path": file_path,
            "content": content,
        }
    )


# ---------------------------------------------------------------------------
# Write file
# ---------------------------------------------------------------------------

@app.put("/api/projects/<project_id>/files/<path:file_path>")
def write_file(project_id, file_path):
    user, error = require_auth()

    if error:
        return error

    project_id = project_uuid(project_id)

    if not project_id:
        return jsonify(
            {
                "error": "invalid_project_id",
            }
        ), 400

    data = request.get_json(silent=True) or {}

    content = data.get("content")

    if not isinstance(content, str):
        return jsonify(
            {
                "error": "content_must_be_string",
            }
        ), 400

    with get_conn() as conn:
        project = project_for_user(
            conn,
            project_id,
            user["sub"],
        )

    if not project:
        return jsonify(
            {
                "error": "project_not_found",
            }
        ), 404

    role = project["role"]

    if role not in (
        "editor",
        "admin",
        "owner",
    ):
        return jsonify(
            {
                "error": "write_permission_required",
            }
        ), 403

    try:
        path = safe_project_path(
            PROJECT_ROOT,
            project_id,
            file_path,
        )
    except ValueError:
        return jsonify(
            {
                "error": "invalid_file_path",
            }
        ), 400

    os.makedirs(
        os.path.dirname(path),
        exist_ok=True,
    )

    with open(
        path,
        "w",
        encoding="utf-8",
    ) as handle:
        handle.write(content)

    return jsonify(
        {
            "ok": True,
            "path": file_path,
            "bytes": len(content.encode("utf-8")),
        }
    )


