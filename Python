@app.post("/api/projects/<project_id>/git/commit")
def git_commit(project_id):
    user, error = require_auth()

    if error:
        return error

    project_id = project_uuid(project_id)

    if not project_id:
        return jsonify(
            {
                "error": "invalid_project_id",
            }
        ), 400

    data = request.get_json(silent=True) or {}

    message = data.get(
        "message",
        "Update files",
    ).strip()

    if not message:
        return jsonify(
            {
                "error": "commit_message_required",
            }
        ), 400

    with get_conn() as conn:
        project = project_for_user(
            conn,
            project_id,
            user["sub"],
        )

    if not project:
        return jsonify(
            {
                "error": "project_not_found",
            }
        ), 404

    if project["role"] not in (
        "editor",
        "admin",
        "owner",
    ):
        return jsonify(
            {
                "error": "write_permission_required",
            }
        ), 403

    repo_path = os.path.join(
        PROJECT_ROOT,
        project_id,
    )

    try:
        result = commit_all(
            repo_path,
            message,
            author_email=user.get("email"),
        )
    except Exception as exc:
        return jsonify(
            {
                "error": "git_commit_failed",
                "detail": str(exc),
            }
        ), 500

    return jsonify(result)


